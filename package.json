{
  "name": "recipeatlas-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve --host localhost --port 4200 --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"*.json\""
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || ^26.0.0"
  },
  "dependencies": {
    "@angular/cdk": "22.2.2",
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/material": "22.2.2",
    "@angular/platform-browser": "22.2.1",
    "@angular/router": "22.2.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.1",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "vitest": "^4.1.11"
  }
