{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "shell",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/*.js",
          "/*.css",
          "/favicon.svg",
          "/manifest.webmanifest",
          "/icons/*.png"
        ]
      }
    }
  ],
  "dataGroups": [],
  "navigationUrls": [
    "/",
    "/login",
    "/cookbooks",
    "/cookbooks/**",
    "/shopping-lists",
    "/shopping-lists/**",
    "/account",
    "/admin",
    "/settings",
    "/invite"
  ],
  "navigationRequestStrategy": "performance"
}
